<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Assignment_1.Views"
    xmlns:style="clr-namespace:Assignment_1.Resources.Fonts"
    Shell.FlyoutBehavior="Flyout"
    xmlns:app="clr-namespace:Assignment_1"
    x:Class="Assignment_1.AppShell"
    FlyoutBackgroundColor="#263238">

    <FlyoutItem Title="Resevation" Icon="{FontImage FontFamily=FontAwesomeSolid, Color=NavajoWhite,
        Glyph={x:Static style:FontAwesomeSolid.Pen}}">
        <ShellContent Route="ResevationPage" ContentTemplate="{DataTemplate local:ResevationPage}">
        </ShellContent>
    </FlyoutItem>

    <FlyoutItem Title="Overview Over Reservations" Icon="{FontImage FontFamily=FontAwesomeSolid, Color=NavajoWhite,
        Glyph={x:Static style:FontAwesomeSolid.BookOpen}}">
        <ShellContent Route="OverviewPage" ContentTemplate="{DataTemplate local:OverviewPage}">
        </ShellContent>
    </FlyoutItem>

    <FlyoutItem Title="Invoice" Icon="{FontImage FontFamily=FontAwesomeSolid, Color=NavajoWhite,
        Glyph={x:Static style:FontAwesomeSolid.Receipt}}">
        <ShellContent Route="InvoicePage" ContentTemplate="{DataTemplate local:InvoicePage}">
        </ShellContent>
    </FlyoutItem>
</Shell>
